(gooros_auth) {
	{$GOOROS_BASIC_AUTH_DIRECTIVE} {
		{$GOOROS_DASH_USER} {$GOOROS_DASH_PASS_HASH}
	}
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
	}
}

{$GOOROS_MISSION_HOST} {
	import gooros_auth
	encode zstd gzip
	reverse_proxy 127.0.0.1:51763
}

{$GOOROS_HERMES_HOST} {
	import gooros_auth
	encode zstd gzip
	reverse_proxy 127.0.0.1:9119 {
		header_up Host 127.0.0.1:9119
	}
}

{$GOOROS_ROUTER_HOST} {
	route {
		import gooros_auth
		encode zstd gzip

		@openai_api path /v1/*
		respond @openai_api "9Router API is local-only on this install" 403

		@router_root path /
		redir @router_root /dashboard 302

		reverse_proxy 127.0.0.1:20128
	}
}
