[Unit]
Description=9Router local dashboard and OpenAI-compatible endpoint
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%GOOROS_SERVICE_USER%
Group=%GOOROS_SERVICE_GROUP%
EnvironmentFile=-/etc/gooros/hermes-mission-control.env
Environment=HOME=%GOOROS_SERVICE_HOME%
Environment=PATH=%GOOROS_SERVICE_PATH%
Environment=HOST=127.0.0.1
Environment=HOSTNAME=127.0.0.1
Environment=PORT=20128
ExecStart=%GOOROS_9ROUTER_BIN%
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
