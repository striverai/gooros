[Unit]
Description=Hermes native dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%GOOROS_SERVICE_USER%
Group=%GOOROS_SERVICE_GROUP%
EnvironmentFile=-/etc/gooros/hermes-mission-control.env
Environment=HOME=%GOOROS_SERVICE_HOME%
Environment=PATH=%GOOROS_SERVICE_PATH%
ExecStart=%GOOROS_HERMES_BIN% dashboard --host 127.0.0.1 --port 9119 --no-open
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
