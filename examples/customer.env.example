# Copy this file to ~/gooros-customer.env on the customer's VPS.
# Fill real values there. Do not commit the filled file.

GOOROS_OWNER_NAME="Customer Name"
GOOROS_OWNER_WORK="Customer business"
GOOROS_OWNER_FOCUS="Current goal"
GOOROS_TIMEZONE="Asia/Ho_Chi_Minh"

# From BotFather. Keep private.
TELEGRAM_BOT_TOKEN="123456789:REPLACE_WITH_CUSTOMER_BOT_TOKEN"

# Telegram forum group and topic IDs.
TELEGRAM_CHAT_ID="-1001234567890"
TELEGRAM_ALLOWED_USERS="123456789,987654321"
TELEGRAM_THREAD_SCOUT="11"
TELEGRAM_THREAD_SCRIBE="12"
TELEGRAM_THREAD_REACH="13"
TELEGRAM_THREAD_DEV="14"
TELEGRAM_HOME_CHANNEL="telegram:-1001234567890"

# Public dashboard HTTPS via sslip.io + Caddy.
GOOROS_PUBLIC_IP="203.0.113.10"
GOOROS_ACME_EMAIL="owner@example.com"
GOOROS_DASH_USER="gooros"

# Optional. Leave blank to generate and print once during install.
GOOROS_DASH_PASSWORD=""

GOOROS_MODEL_POLICY="deepseek-free-first"

# Emergency-only: export this in the shell, not in Git, if you must update UI/services
# before the customer has connected a working 9Router provider.
# GOOROS_9ROUTER_SMOKE=0
